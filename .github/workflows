# ─────────────────────────────────────────────────────────────────────────────
# Copy this file into backend-trafficpay/.github/workflows/trigger.yml
#
# It has no build logic — it only pings the infra repo to kick off CI.
# All DevOps logic lives in trafficpay-infra.
# ─────────────────────────────────────────────────────────────────────────────

name: Notify infra repo — trigger CI

on:
  push:
    branches: [main]

jobs:
  dispatch:
    runs-on: ubuntu-latest
    steps:
      - name: Dispatch CI to trafficpay-infra
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GH_PAT }}
          script: |
            await github.rest.repos.createDispatchEvent({
              owner:      context.repo.owner,
              repo:       'trafficpay-infra',
              event_type: 'source-push',
              client_payload: {
                source: 'backend-trafficpay',
                sha:    context.sha
              }
            })
